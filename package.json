{
  "name": "@fliq/cli",
  "version": "0.1.0",
  "description": "fliq — Fliq Payments CLI and MCP server. Accounts, balances, transactions and payment history from the terminal or your AI assistant.",
  "keywords": [
    "fliq",
    "psd2",
    "open-banking",
    "mcp",
    "model-context-protocol",
    "cli",
    "bank",
    "sweden"
  ],
  "homepage": "https://fliqpayments.com/ais",
  "bugs": {
    "url": "https://github.com/Avanoro/fliq-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avanoro/fliq-cli.git"
  },
  "license": "MIT",
  "author": "Fliq Payments AB",
  "type": "module",
  "bin": {
    "fliq": "bin/fliq.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx/esm src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "commander": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "wrangler": "^4.133.0"
  }
}
