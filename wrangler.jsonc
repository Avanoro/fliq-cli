{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Remote MCP server for Fliq — demo mode, read-only, stateless. Deployed by
  // Workers Builds from GitHub (push to main = deploy). The CLI itself is not
  // deployed anywhere; it ships on npm. See src/worker.ts.
  "name": "fliq-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "keep_vars": true,
  // The public endpoint. The workers.dev URL still answers; this is the name
  // clients are given, and the one the docs and /ais print.
  "routes": [{ "pattern": "mcp.fliqpayments.com", "custom_domain": true }],
  "vars": {
    // What `/` and `/health` advertise as the endpoint. Left unset on purpose:
    // the request origin is used, so the custom domain and the workers.dev URL
    // each advertise themselves instead of one lying about the other.
  }
}
